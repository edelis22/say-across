{
  "name": "Click",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "Click", "onAutoForward": "openBrowser" }
  },
  // The smallest Codespaces machine, which is the cheapest in core-hours and
  // the one a free personal account is offered. Translation is slower on it
  // but fits: asking for more would force a larger, faster-billing machine.
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python3.11" }
    }
  },
  "remoteEnv": {
    "HF_HOME": "${containerWorkspaceFolder}/.model-cache",
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "GRADIO_ANALYTICS_ENABLED": "False"
  }
}
